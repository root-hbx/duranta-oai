# Selected radio and TCP settings, sourced by xrat.sh after its orbit calibration.
# THROUGHPUT_PROFILE=baseline uses 25/25 PRB with the current source; tuned uses 100/52 PRB.
case $THROUGHPUT_PROFILE in
  baseline) export LTE_PRB=25 LTE_RXGAIN=140 LTE_UL_RB_INDEX=22 RF_CHANNEL_OPTIMIZED=0
    export IPERF_EXTRA= ;;
  tuned) export LTE_PRB=100 LTE_RXGAIN=128 LTE_UL_RB_INDEX=27 RF_CHANNEL_OPTIMIZED=1
    export IPERF_EXTRA="--fq-rate 35M"
    [ "${TRAFFIC:-DL}" != UL ] || export IPERF_EXTRA="$IPERF_EXTRA -w 384K" ;;
  *) echo "THROUGHPUT_PROFILE must be baseline or tuned" >&2; return 1 ;;
esac

export LTE_UE_EXTRA="--rfsimulator.[0].channelmod_optimized $RF_CHANNEL_OPTIMIZED"
export ENB1_EXTRA="$ENB1_EXTRA --eNBs.[0].component_carriers.[0].N_RB_DL $LTE_PRB $LTE_UE_EXTRA"
[ "${TRAFFIC:-DL}" != UL ] || export ENB1_EXTRA="$ENB1_EXTRA --MACRLCs.[0].max_ul_rb_index $LTE_UL_RB_INDEX"
export GNB1_EXTRA="$GNB1_EXTRA $LTE_UE_EXTRA" GNB2_EXTRA="$GNB2_EXTRA $LTE_UE_EXTRA"
export UE_EXTRA="$UE_EXTRA $LTE_UE_EXTRA"

if [ "$THROUGHPUT_PROFILE" = tuned ]; then
  : "${NR_UECAP:?Set the generated NR capability path}"
  bwp=--gNBs.[0].servingCellConfigCommon.[0]
  nr="$bwp.dl_carrierBandwidth 52 $bwp.ul_carrierBandwidth 52
      $bwp.initialDLBWPlocationAndBandwidth 14025 $bwp.initialULBWPlocationAndBandwidth 14025
      --gNBs.[0].force_256qam_off 0 --gNBs.[0].force_UL256qam_off 1 --gNBs.[0].maxMIMO_layers 1"
  export GNB1_EXTRA="$GNB1_EXTRA $nr" GNB2_EXTRA="$GNB2_EXTRA $nr"
  export UE_EXTRA="$UE_EXTRA --cells.[0].N_RB_DL 52 --cells.[0].rf_freq 2490830000 --uecap_file $NR_UECAP"
  export UE_FO=$(awk -v f="$UE_FO" 'BEGIN { printf "%.0f", f * 2490830000 / 2488400000 }')
fi
